# For running the server on your own machine (go run .). A deployed app does
# not read this file: dibbla.yaml sets its environment, and its credential is
# the app's own identity.

# Use a name of your own here, not the deployed one: a name belongs to the
# app that runs it, and the platform refuses a second server under it.
SERVER_NAME=my-mcp-local

# A personal API token from the Dibbla console (developer role or higher).
SERVER_API_TOKEN=your_api_token_here

# grpc.<your-dibbla-domain>:443
GRPC_SERVER_ADDRESS=grpc.dibbla.com:443
GRPC_USE_TLS=true
